ALLOWED_EXTENSIONS=jpg,jpeg,png,bmp,tiff,gif,webp

# ── OCR / Tesseract ───────────────────────────────────────
TESSERACT_CMD="C:\ProgramData\Microsoft\Windows\Start Menu\Programs\Tesseract-OCR"

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
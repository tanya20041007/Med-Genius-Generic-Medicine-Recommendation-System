# ── Flask Secret Key ──────────────────────────────────────
SECRET_KEY=6819977c3d470f2bc44b5447f9f56c5ef9cb27c45734339ff1a9b50c4917a085

# ── Flask Environment ─────────────────────────────────────
FLASK_ENV=development

# ── Server ───────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000

# ── JWT Token Expiry (hours) ──────────────────────────────
